CM_ BO_ 1585 "Battery cell info and packed fault bits (0x631).";
CM_ BO_ 1584 "Battery pack info and warning bits (0x630).";
CM_ BO_ 1616 "Vehicle CAN fault bit map (0x650). Single ID muxed by Byte7 FaultLevel. One level per 100ms: LV1->LV2->LV3, full cycle 300ms. Bit n = ET_FaultVariety n.";
CM_ SG_ 1616 HotFault "[0] hot fault";
CM_ SG_ 1616 InsulationFault "[1] insulation fault";
CM_ SG_ 1616 DaisyChainFault "[2] daisy chain communication fault";
CM_ SG_ 1616 RelayAdhseionFault "[3] relay adhesion";
CM_ SG_ 1616 HeatRelayOpenCircuitFault "[4] heat relay open circuit";
CM_ SG_ 1616 ChgCirFault "[5] charge circuit fault";
CM_ SG_ 1616 DsgCirFault "[6] discharge circuit fault";
CM_ SG_ 1616 SOHFault "[7] SOH fault";
CM_ SG_ 1616 PowerDetectionFault "[8] power on detection fault";
CM_ SG_ 1616 PowerOffFault "[9] power off fault";
CM_ SG_ 1616 Fault12V "[10] 12V/24V power fault";
CM_ SG_ 1616 Fault5V "[11] 5V power fault";
CM_ SG_ 1616 Fault3V3 "[12] 3.3V power fault";
CM_ SG_ 1616 BalanceFault "[13] balance circuit fault";
CM_ SG_ 1616 OVInvalidFault "[14] 0V invalid fault";
CM_ SG_ 1616 DriverInstanaceCurFault "[15] driver instance current fault";
CM_ SG_ 1616 DriverContinueCurFault "[16] driver continue current fault";
CM_ SG_ 1616 BranchCurFault "[17] branch current fault";
CM_ SG_ 1616 NegRelayAdhseionFault "[18] negative relay adhesion";
CM_ SG_ 1616 PosRelayAdhseionFault "[19] positive relay adhesion";
CM_ SG_ 1616 LimitVoltFault "[20] over limit voltage";
CM_ SG_ 1616 ShuntOpenCircuitFault "[21] shunt open circuit";
CM_ SG_ 1616 BMUShuntOpenCircuitFault "[22] BMU shunt open circuit";
CM_ SG_ 1616 HVILFault "[23] HVIL fault";
CM_ SG_ 1616 SwitchFault "[24] PDU switch fault";
CM_ SG_ 1616 CellSensorFault "[25] cell sensor fault";
CM_ SG_ 1616 TempSensorFault "[26] temperature sensor fault";
CM_ SG_ 1616 DasTempSensorFault "[27] DAS temperature sensor fault";
CM_ SG_ 1616 AutoSleepRelayFault "[28] auto sleep relay fault";
CM_ SG_ 1616 ChgRelayAdhseionFault "[29] charge relay adhesion";
CM_ SG_ 1616 HeatRelayAdhseionFault "[30] heat relay adhesion";
CM_ SG_ 1616 BranchOpenCirFault "[31] branch open circuit";
CM_ SG_ 1616 HeatPadInvalid "[32] heat pad invalid";
CM_ SG_ 1616 NegRelayOpenCircuitFault "[33] negative relay open circuit";
CM_ SG_ 1616 PosRelayOpenCircuitFault "[34] positive relay open circuit";
CM_ SG_ 1616 ChgRelayOpenCircuitFault "[35] charge relay open circuit";
CM_ SG_ 1616 HeatRelayOpenCircuit "[36] heat relay open circuit";
CM_ SG_ 1616 ChgEquipmentFault "[37] charge equipment fault";
CM_ SG_ 1616 OBCChgEquipmentFault "[38] OBC charge equipment fault";
CM_ SG_ 1616 OBCStopFault "[39] OBC stop charge fault";
CM_ SG_ 1616 PackShuntInvalid "[40] pack shunt invalid";
CM_ SG_ 1616 Thermalrunaway "[41] thermal runaway";
CM_ SG_ 1616 HVDetectionFault "[42] high-voltage detection fault";
CM_ SG_ 1616 TwoGunsFault "[43] two guns detection fault";
CM_ SG_ 1616 SetandGetBmuNum "[44] BMU number set/get mismatch";
CM_ SG_ 1616 FaultLevel "1=LV1 First_Level_Fault, 2=LV2 Second_Level_Fault, 3=LV3 Third_Level_Fault";
CM_ BO_ 1619 "Vehicle CAN alarm bit map (0x653). Single ID muxed by Byte7 AlarmLevel. One level per 100ms: LV1->LV2->LV3, full cycle 300ms. Same level as 0x650 in this period. Bit n = ET_AlarmVariety n.";
CM_ SG_ 1619 Alarm_CellVoltMax "[0] over cell voltage";
CM_ SG_ 1619 Alarm_CellVoltMin "[1] under cell voltage";
CM_ SG_ 1619 Alarm_CellVoltDiff "[2] over cell voltage difference";
CM_ SG_ 1619 Alarm_ModuleVoltDiff "[3] over module voltage difference";
CM_ SG_ 1619 Alarm_TotalVoltMax "[4] over total voltage";
CM_ SG_ 1619 Alarm_TotalVoltMin "[5] under total voltage";
CM_ SG_ 1619 Alarm_ChgTempHigh "[6] over charge temperature";
CM_ SG_ 1619 Alarm_ChgTempLow "[7] under charge temperature";
CM_ SG_ 1619 Alarm_DsgTempHigh "[8] over discharge temperature";
CM_ SG_ 1619 Alarm_DsgTempLow "[9] under discharge temperature";
CM_ SG_ 1619 Alarm_CellTempDiff "[10] over cell temperature difference";
CM_ SG_ 1619 Alarm_ELECTemp1High "[11] over elec-comp temperature 1";
CM_ SG_ 1619 Alarm_ELECTemp2High "[12] over elec-comp temperature 2";
CM_ SG_ 1619 Alarm_ELECTemp3High "[13] over elec-comp temperature 3";
CM_ SG_ 1619 Alarm_ChgCurOver "[14] over charge current";
CM_ SG_ 1619 Alarm_SteadyDsgCurOver "[15] steady over discharge current";
CM_ SG_ 1619 Alarm_TransDsgCurOver "[16] transient over discharge current";
CM_ SG_ 1619 Alarm_CellTempRise "[17] over cell temperature rise";
CM_ SG_ 1619 Alarm_BMUTempDiff "[18] BMU temperature difference high";
CM_ SG_ 1619 Alarm_BPInsultagtionLow "[19] under pack positive insulation";
CM_ SG_ 1619 Alarm_BNInsultagtionLow "[20] under pack negative insulation";
CM_ SG_ 1619 Alarm_CellVoltDrop "[21] over cell voltage drop";
CM_ SG_ 1619 AlarmLevel "1=LV1 First_Level_Alarm, 2=LV2 Second_Level_Alarm, 3=LV3 Third_Level_Alarm";
CM_ BO_ 1622 "Vehicle CAN PowerStage (0x656). Byte0 = ET_PowerManagementStage, Byte1 = CHGType, Byte2-3 = ChgRequestCur, Byte4 = ChgDsgMode, Byte5 = FastCharge. Period 100ms.";
CM_ SG_ 1622 PowerStage "Apl_GetPowerSysStatus / ET_PowerManagementStage";
CM_ SG_ 1622 CHGType "Apl_Get_ChgType_FLAG";
CM_ SG_ 1622 ChgRequestCur "Apl_Get_ChgRequestCur offset by CHG_CURRENT(0). Motorola 16-bit, 0.1A";
CM_ SG_ 1622 ChgDsgMode "Apl_Get_ChgDsgMode / ET_ChgDsgMode";
CM_ SG_ 1622 FastCharge "s_ALARMHINFO.e_FastCharge / Apl_GetFastChargeAlarmHandele";
CM_ BO_ 768 "Vehicle CAN cell temperatures (0x300). Single ID muxed by Byte6 AFE_Index. One AFE per 100ms, full cycle 800ms. raw=(T+40)*10, Motorola 16-bit.";
CM_ SG_ 768 CellTemp0 "Cell temperature channel 0 of AFE_Index";
CM_ SG_ 768 CellTemp1 "Cell temperature channel 1 of AFE_Index";
CM_ SG_ 768 CellTemp2 "Cell temperature channel 2 of AFE_Index";
CM_ SG_ 768 AFE_Index "AFE index 0~7. Same AFE as 0x301/0x310 in this 100ms period.";
CM_ BO_ 769 "Vehicle CAN per-AFE BSUP voltage/current (0x301). Muxed by Byte6 AFE_Index. Same AFE as 0x300/0x310 in this 100ms period.";
CM_ SG_ 769 BSUP_Voltage "AFE module voltage = sum of cell mV / 10. Motorola 16-bit, 0.01V";
CM_ SG_ 769 BSUP_Current "Fml_DataAfe_Get_Cur(AFE) signed vs CHG_CURRENT(0). Motorola 16-bit, 0.1A, charge +, discharge -";
CM_ SG_ 769 AFE_Index "AFE index 0~7. Same AFE as 0x300/0x310 in this 100ms period.";
CM_ BO_ 784 "Vehicle CAN cell voltages (0x310). Single ID muxed by Byte6 AFE_Index and Byte7 Subframe. Intel 12-bit x4 cells/frame, 4 frames per AFE per 100ms, full cycle 800ms. 0.001V, 0~4.095V.";
CM_ SG_ 784 CellVolt0 "Cell voltage of (Subframe*4+0)";
CM_ SG_ 784 CellVolt1 "Cell voltage of (Subframe*4+1)";
CM_ SG_ 784 CellVolt2 "Cell voltage of (Subframe*4+2)";
CM_ SG_ 784 CellVolt3 "Cell voltage of (Subframe*4+3), unused on subframe 3";
CM_ SG_ 784 AFE_Index "AFE index 0~7. Same AFE as 0x300/0x301 in this 100ms period.";
CM_ SG_ 784 Subframe "0:Cell0-3  1:Cell4-7  2:Cell8-11  3:Cell12-14";

