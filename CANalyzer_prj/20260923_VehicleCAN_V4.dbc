CM_ BO_ 1161 "Vehicle CAN RX Timer (0x489). Vector__XXX -> BMS.";
CM_ SG_ 1161 Timer_Enabler "TMS Timer_Enabler bits for contactor/heat enable";
CM_ BO_ 905 "TMS Status TX (0x389). Alternates with 0x309 every 1000ms, ID period 2000ms.";
CM_ SG_ 905 BMS_Status "bit0 Init, bit1 Driving, bit2 Alarm, bit3 Fault";
CM_ SG_ 905 Charger_Status "0x01 Idle, 0x02 Charging, 0x04 ChargeEnd, 0x08 PlugConnect";
CM_ SG_ 905 Relay_Status "Byte2-3 relay open/adhesion bits";
CM_ SG_ 905 Temp_Status "Fault_TempSensorFault";
CM_ SG_ 905 SOC "SHOW_SOC / 10";
CM_ SG_ 905 SOH "REAL_SOH / 10";
CM_ BO_ 777 "TMS DAS temperature TX (0x309). Alternates with 0x389 every 1000ms. raw = DAS_TEMPn/10 + 80, Physical = raw - 80.";
CM_ SG_ 777 DasTemp1 "DAS_TEMP1";
CM_ SG_ 777 DasTemp2 "DAS_TEMP2";
CM_ SG_ 777 DasTemp3 "DAS_TEMP3";
CM_ SG_ 777 DasTemp4 "DAS_TEMP4";
CM_ BO_ 1283 "Vehicle CAN Version/Capacity (0x503). Round-robin slot among 0x630~0x638/0x403/0x503/0x632, slot period 100ms, ID period 700ms.";
CM_ SG_ 1283 Version "SOFT_VERSION_CAN_H/L Motorola u16";
CM_ SG_ 1283 Capacity "BATTERY_CAPACITY * (SYS_ENERY_TYPE + 20kWh base) duplicated in Byte2-3";
CM_ SG_ 1283 FastChargerWakeUp "PowerM_IsFastChargerWakeUp";
CM_ SG_ 1283 SlowChargerWakeUp "PowerM_IsSlowChargerWakeUp";
CM_ SG_ 1283 OBCChgSendBitFlag "Apl_OBCChgSendBitFlag";
CM_ BO_ 1027 "Vehicle CAN charging request/feedback (0x403). Sent only meaningful when Apl_Get_ChgState() > Chg_PlugConnect. ID period 700ms.";
CM_ SG_ 1027 Request_Current "Apl_Get_ChgRequestCur() - CHG_CURRENT(0). Motorola s16, 0.1A";
CM_ SG_ 1027 Charging_Voltage "Apl_Get_ChgRequestVol(). Motorola u16, 0.01V";
CM_ SG_ 1027 Charging_Current "TOTAL_CURRENT - CHG_CURRENT(0). Motorola s16, 0.1A";
CM_ BO_ 1584 "Battery pack info (0x630). TOTAL_AFE_VOLTAGE / TOTAL_CURRENT / SHOW_SOC / CELL_AVR_VOLTAGE + warning bits. ID period 700ms.";
CM_ SG_ 1584 Pack_Voltage "TOTAL_AFE_VOLTAGE. Motorola 0.01V";
CM_ SG_ 1584 Pack_Current "TOTAL_CURRENT signed vs CHG/DSG offset. Motorola 0.1A";
CM_ SG_ 1584 Pack_SOC "SHOW_SOC / 10";
CM_ SG_ 1584 Ave_Cell_Voltage "CELL_AVR_VOLTAGE. Motorola 0.001V";
CM_ SG_ 1584 Warn_OV "Cell/Total OV LV2|LV3";
CM_ SG_ 1584 Warn_UV "Cell/Total UV LV2|LV3";
CM_ SG_ 1584 Warn_CellVoltDiff "CellVoltDiff any level";
CM_ SG_ 1584 Warn_DsgTempHigh "DsgTempHigh LV2|LV3";
CM_ SG_ 1584 Warn_ChgTempHigh "ChgTempHigh LV2|LV3";
CM_ SG_ 1584 Warn_CellTempDiff "CellTempDiff LV2|LV3";
CM_ SG_ 1584 Warn_ChgCurOver "ChgCurOver LV3";
CM_ SG_ 1584 Warn_DsgCurOver "Steady|Trans DsgCurOver LV3";
CM_ BO_ 1585 "Battery cell info (0x631). Min/Max cell V/T + L1 alarm/fault bits. Temp raw = stored/10 + 40 (=T+80). ID period 700ms.";
CM_ SG_ 1585 Min_Cell_Voltage "CELL_MIN_VOLTAGE. Motorola 0.001V";
CM_ SG_ 1585 Max_Cell_Voltage "CELL_MAX_VOLTAGE. Motorola 0.001V";
CM_ SG_ 1585 Min_Temperature "CELL_MIN_TEMPERATURE encoded. Physical = raw - 80";
CM_ SG_ 1585 Max_Temperature "CELL_MAX_TEMPERATURE encoded. Physical = raw - 80";
CM_ SG_ 1585 BMS_Fault "1 when Fml_GetSystemFaultStatus()==FALSE (fault active)";
CM_ SG_ 1585 PosNegRelayFault "Pos adhesion/open or Neg open";
CM_ SG_ 1585 ChgRelayOpenFault "ChgRelayOpenCircuitFault";
CM_ SG_ 1585 PosRelayClosed "Pos relay Close";
CM_ SG_ 1585 ChgRelayClosed "Chg relay Close";
CM_ BO_ 1586 "Charge request mirror of charger F4 style (0x632). ID period 700ms.";
CM_ SG_ 1586 Request_Total_Voltage "REQUESTTOTALVOLT(37) * paraCout * BMU_CELL_NUM. Motorola 0.1V";
CM_ SG_ 1586 Request_Charge_Current "RealCHG_CURRENT when StopFlag==0 else 0. Motorola 0.1A";
CM_ SG_ 1586 StopFlag "0 allow, 1 stop, 2 heat-start";
CM_ SG_ 1586 Pack_SOC "SHOW_SOC / 10";
CM_ SG_ 1586 HeatMode "Apl_GetHeatMode() (e_HeatMode, heating request state)";
CM_ SG_ 1586 HeatPadState "Apl_Get_HeatState() (bHeatState, actual pad on/off after Close/Open sequence)";
CM_ BO_ 1591 "Vehicle status/fault bit pack + life time (0x637). ID period 700ms.";
CM_ SG_ 1591 LimitOrSleepFault "AlarmLimit(DL/CL/FaultMode) | AutoSleepRelayFault";
CM_ SG_ 1591 InsulationAlarm "BP|BN insulation L1";
CM_ SG_ 1591 DsgTempLow_L3 "DsgTempLow LV3";
CM_ SG_ 1591 HV_ChgRelayFault "HVDetection | Chg/Heat adhesion | Chg open";
CM_ SG_ 1591 HeatThermalFault "HeatPadInvalid | Thermalrunaway";
CM_ SG_ 1591 TwoGunsFault "Fault_TwoGunsFault";
CM_ SG_ 1591 Sys_Life_Time "SYS_LIFE_TIME Motorola u16";
CM_ BO_ 1592 "SOP power limits (0x638). raw = CurrentLimit(A) * TOTAL_AFE_VOLTAGE(0.01V), Motorola u16. ID period 700ms.";
CM_ SG_ 1592 ContDsg_Power1 "ContinuousDsgCurrent * PackVolt";
CM_ SG_ 1592 ContDsg_Power2 "ContinuousDsgCurrent * PackVolt (duplicate)";
CM_ SG_ 1592 InstChg_Power "InstantaneousChgCurrent * PackVolt";
CM_ SG_ 1592 ContChg_Power "ContinuousChgCurrent * PackVolt";

